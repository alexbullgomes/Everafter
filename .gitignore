# Lockfiles concorrentes: o projeto padroniza em npm (vercel.json usa `npm ci`).
# Um yarn.lock ou bun.lockb versionado junto com o package-lock.json e' fonte de
# divergencia entre o que roda local e o que a Vercel instala.
yarn.lock
bun.lock
bun.lockb
